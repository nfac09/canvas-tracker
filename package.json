{
  "name": "canvas-tracker",
  "productName": "Canvas Tracker",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc -b && vite build && electron-builder --mac --publish never",
    "electron:build:mac": "tsc -b && vite build && electron-builder --mac --publish never",
    "electron:build:win": "tsc -b && vite build && electron-builder --win --publish never",
    "electron:build:all": "tsc -b && vite build && electron-builder --mac --win --publish never",
    "electron:build:dir": "tsc -b && vite build && electron-builder --mac --dir",
    "generate-icons": "bash scripts/generate-icons.sh",
    "release": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "build": {
    "appId": "com.canvastracker.app",
    "productName": "Canvas Tracker",
    "copyright": "Copyright © 2025",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "publish": {
      "provider": "github",
      "owner": "nfac09",
      "repo": "canvas-tracker",
      "releaseType": "draft"
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "identity": null,
      "notarize": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Canvas Tracker",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Canvas Tracker"
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "ical.js": "^2.2.1",
    "immer": "^11.1.4",
    "nanoid": "^5.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "png-to-ico": "^2.1.8",
    "wait-on": "^9.0.4"
  }
}
