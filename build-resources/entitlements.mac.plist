<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron / V8 for JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required by Electron for unsigned executable memory pages -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required so Electron can load its own frameworks without library validation -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network access for auto-updates and Canvas calendar fetching -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
